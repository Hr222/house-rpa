# ===== API 服务 =====
API_HOST=127.0.0.1
API_PORT=8000

# ===== RPA 运行配置 =====
# Chrome 可执行文件路径
BROWSER_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# 是否导出调试页面 HTML
RPA_DEBUG=0
# 结果回调地址；留空则由客户端通过 GET 兜底查询
RPA_CALLBACK_URL=
# 同一任务两次 GET 查询的最小间隔（秒）
RPA_GET_MIN_INTERVAL=10
# 弱面积参考允许的最大面积容差（平方米）
RPA_WEAK_AREA_MAX_TOLERANCE=20

# 钉钉自动化机器人Webhook
DINGTALK_WEBHOOK_URL=ABC

# 腾讯地图 WebService 配置
TENCENT_MAP_API_KEY=replace-with-your-tencent-map-api-key
TENCENT_MAP_API_SK=replace-with-your-tencent-map-api-sk

# 附近小区查询的方圆半径，单位：米
COMMUNITY_NEARBY_RADIUS_METERS=10000

# ===== 热数据短路（询价时 48h 内更新过的小区×平台直接用库内数据）=====
# 热数据窗口（小时，支持小数）
RPA_HOT_DATA_MAX_AGE_HOURS=48
# 激活热路径需要的最少热平台数（不足则全部走 RPA）
RPA_HOT_DATA_MIN_PLATFORMS=3
